{
  "expo": {
    "name": "Rojgar Mitra",
    "slug": "Rojgar_Mitra_App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "rojgar-mitra",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#14315B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rojgarmitra.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14315B"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.rojgarmitra.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Rojgar Mitra",
      "shortName": "Rojgar Mitra",
      "lang": "en-IN",
      "description": "Gujarat government job notices with last dates, eligibility and document checklists, in English, Gujarati and Hindi.",
      "themeColor": "#14315B",
      "backgroundColor": "#F4F5F7",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "preferRelatedApplications": true
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
