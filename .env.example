# Supabase Configuration
# Get these values from your Supabase project dashboard -> Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# AI practice tests do NOT need an LLM key in this file.
# The Command Code API key is stored as a server secret for the generate-test Edge Function:
#   npx supabase secrets set LLM_API_KEY=<your Command Code key>
# Never add provider keys with the EXPO_PUBLIC_ prefix: Expo bundles those into the app.

# Note: EXPO_PUBLIC_ prefix is required for Expo to include env vars in the native bundle
# Never expose Service Role Key in frontend code - use only in Supabase Edge Functions